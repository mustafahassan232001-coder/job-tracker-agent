# Copy this file to .env and fill in your own values. Never commit .env.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# One CV or a comma-separated list of CV PDF paths, relative to the project folder.
CV_PATHS=resume_one.pdf,resume_two.pdf
# When using only one CV, use CV_PATH=resume_one.pdf instead.
# CV_PATH=resume_one.pdf

# The first candidate uses MY_CV_EMAILS / NOTIFICATION_EMAILS.
# The second CV is detected using SECOND_CV_KEYWORDS and uses SECOND_CV_EMAIL.
MY_CV_EMAILS=you@example.com
SECOND_CV_EMAIL=
SECOND_CV_KEYWORDS=second_candidate,alternate_cv,resume_two

# SMTP credentials. For Gmail use an App Password, not your account password.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Local SearXNG JSON endpoint. See docker-compose.searxng.yml and searxng/settings.example.yml.
SEARXNG_URL=http://localhost:8888/search

# Set your own region names and query terms as a JSON object.
# Example below covers Europe, Gulf countries, and North Africa; edit to fit your needs.
SEARCH_REGIONS_JSON='{"Europe":"Germany OR Czechia OR Netherlands OR Poland OR Ireland OR Austria","Gulf":"UAE OR Dubai OR Saudi Arabia OR Qatar OR Kuwait OR Oman OR Bahrain","North Africa":"Egypt OR Cairo OR Alexandria"}'

OUTPUT_DIR=output
MAX_RESULTS_PER_REGION=10
MAX_RESULTS_PER_SITE=10
MAX_RESULTS_PER_LINKEDIN_QUERY=20
MAX_JOB_URLS_TO_VERIFY=250
MAX_JOBS_TO_ASSESS=120
JOB_ASSESSMENT_BATCH_SIZE=20
JOB_URL_TIMEOUT=8
JOB_URL_VERIFY_WORKERS=10

STRONG_FIT_MIN_SCORE=75
APPLICATION_MIN_FIT_SCORE=80
MAX_APPLICATION_PACKAGES_PER_RUN=10
SEND_JOB_DIGEST_EMAILS=true
SEND_CAREER_FEEDBACK_EMAIL=true
VERIFY_JOB_URLS=true
RESEND_CATEGORY_EMAILS_EACH_RUN=false
AUTO_APPLY_ENABLED=false
